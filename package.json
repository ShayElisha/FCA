{
  "name": "fca-container-tracker",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"npm:client\"",
    "client": "vite",
    "server": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "playwright:install": "playwright install chromium"
  },
  "dependencies": {
    "@sparticuz/chromium": "^143.0.4",
    "@vercel/node": "^5.3.24",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "playwright": "1.49.1",
    "playwright-core": "1.49.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "typescript": "~5.6.2",
    "vite": "^5.4.11"
  }
}
